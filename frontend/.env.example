# =====================================================
# EDUVERSE FRONTEND — ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and fill in your values.
# For Vercel deployment, set these as Environment Variables
# in the Vercel Project Settings → Environment Variables.
# All variables MUST be prefixed with VITE_ to be
# accessible in the browser bundle.
# =====================================================

# Your Render backend URL (no trailing slash)
VITE_API_URL=https://your-api.onrender.com

# Supabase project credentials (public keys — safe to expose)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth Client ID (used for the Google Sign-In button)
# Must match the Client ID configured in Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# App display name
VITE_APP_NAME=Eduverse
